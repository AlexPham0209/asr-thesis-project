#!/bin/bash
#SBATCH -N 1
#SBATCH -p GPU-shared
#SBATCH -t 12:00:00
#SBATCH --gpus=v100-32:1
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err

# Builds the text index (whisper_text -> sentence embedding) and stores one FLAC
# per indexed row under vector_db/audio/<collection>/ for the multimodal cascade.
# Usage: sbatch text_rag_db_generate.job [embedding] [collection_name] [store_audio]
#   e.g. sbatch text_rag_db_generate.job e5 speech2latex-e5-text true
EMBEDDING=${1:-bge}
COLLECTION_NAME=${2:-speech2latex-${EMBEDDING}-text}
STORE_AUDIO=${3:-true}

set -x

cd /ocean/projects/cis250209p/apham8/asr-thesis-project || exit 1

module load anaconda3
source $(conda info --base)/etc/profile.d/conda.sh
conda activate env

export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH

python \
    -m asr_thesis_project.data.generate_text_rag_dataset \
    embedding=$EMBEDDING \
    collection_name=$COLLECTION_NAME \
    store_audio=$STORE_AUDIO \
    num_proc=${SLURM_CPUS_ON_NODE:-4}
