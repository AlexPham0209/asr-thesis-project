#!/bin/bash
#SBATCH -N 1
#SBATCH -p GPU-shared
#SBATCH -t 24:00:00
#SBATCH --gpus=v100-32:4
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err

# Echo commands to stdout for tracking
set -x

# Navigate to project directory
cd /ocean/projects/cis250209p/apham8/asr-thesis-project || exit 1

# Safely load and activate environment
module load anaconda3
source $(conda info --base)/etc/profile.d/conda.sh
conda activate env

export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH

# Launch multi-GPU training across all 4 V100s
accelerate launch \
    --num_processes=4 \
    --multi_gpu \
    src/train_asr.py \
    model=whisper_large \
    training=seq2seq \
    lora=whisper \
    use_lora=true \
    use_hyperparameter_search=true \
    n_trials=10 \
    dataset=speech2latex \
    training.max_steps=5000 \