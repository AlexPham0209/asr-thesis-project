#!/bin/bash
#SBATCH -N 1
#SBATCH -p GPU-shared
#SBATCH -t 04:00:00
#SBATCH --gpus=v100-32:1
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err

# Whisper-only baseline on sentences_test (2850 rows).
# Usage: sbatch asr_inference.job [asr_model_id] [max_eval_samples]
#   hub id:         sbatch asr_inference.job openai/whisper-large-v3
#   fine-tuned run: sbatch asr_inference.job models/whisper-small/result
ASR_MODEL_ID=${1:-openai/whisper-small}
MAX_EVAL_SAMPLES=${2:-null}

set -x

cd /ocean/projects/cis250209p/apham8/asr-thesis-project || exit 1

module load anaconda3
source $(conda info --base)/etc/profile.d/conda.sh
conda activate env

export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH

python \
    -m asr_thesis_project.asr_inference \
    asr_model_id=$ASR_MODEL_ID \
    max_eval_samples=$MAX_EVAL_SAMPLES \
    num_proc=${SLURM_CPUS_ON_NODE:-4}
