#!/bin/bash
#SBATCH -N 1
#SBATCH -p GPU-shared
#SBATCH -t 04:00:00
#SBATCH --gpus=v100-32:1
#SBATCH --output=logs/slurm-%j.out
#SBATCH --error=logs/slurm-%j.err

# Whisper-only baseline on sentences_test (2850 rows).
# Usage: sbatch asr_inference.job [asr_model_id=...] [max_eval_samples=...]
#   hub id:         sbatch asr_inference.job asr_model_id=openai/whisper-large-v3
#   fine-tuned run: sbatch asr_inference.job asr_model_id=models/whisper-small/result
ASR_MODEL_ID=openai/whisper-small
MAX_EVAL_SAMPLES=null

for arg in "$@"; do
    case $arg in
        asr_model_id=*) ASR_MODEL_ID="${arg#*=}" ;;
        max_eval_samples=*) MAX_EVAL_SAMPLES="${arg#*=}" ;;
        *) echo "Unknown argument: $arg" >&2; exit 1 ;;
    esac
done

set -x

cd /ocean/projects/cis250209p/apham8/asr-thesis-project || exit 1

module load anaconda3
source $(conda info --base)/etc/profile.d/conda.sh
conda activate env

export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH

python \
    -m asr_thesis_project.asr_inference \
    asr_model_id=$ASR_MODEL_ID \
    max_eval_samples=$MAX_EVAL_SAMPLES \
    num_proc=${SLURM_CPUS_ON_NODE:-4}
