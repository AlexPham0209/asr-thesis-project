#!/bin/bash
#SBATCH -N 1
#SBATCH -p GPU-shared
#SBATCH -t 12:00:00
#SBATCH --gpus=v100-32:1
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err

# Whisper -> text retrieval -> Gemini post-correction.
# Needs GEMINI_API_KEY in the project .env (read by load_dotenv).
# Usage: sbatch post_correction_rag_inference.job [embedding] [collection_name] [top_n] [max_eval_samples]
#   no-retrieval baseline: sbatch post_correction_rag_inference.job bge speech2latex-bge-text 0 results/post_correction_rag_no_retrieval
EMBEDDING=${1:-bge}
COLLECTION_NAME=${2:-speech2latex-${EMBEDDING}-text}
TOP_N=${3:-3}
MAX_EVAL_SAMPLES=${4:-null}
RESULTS_DIRECTORY=${5-results/post_correction_rag}

set -x

cd /ocean/projects/cis250209p/apham8/asr-thesis-project || exit 1

module load anaconda3
source $(conda info --base)/etc/profile.d/conda.sh
conda activate env

export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH

python \
    -m asr_thesis_project.post_correction_rag_inference \
    embedding=$EMBEDDING \
    collection_name=$COLLECTION_NAME \
    top_n=$TOP_N \
    max_eval_samples=$MAX_EVAL_SAMPLES \
    num_proc=${SLURM_CPUS_ON_NODE:-4} \
    results_directory=$RESULTS_DIRECTORY
