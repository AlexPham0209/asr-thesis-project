#!/bin/bash
#SBATCH -N 1
#SBATCH -p GPU-shared
#SBATCH -t 24:00:00
#SBATCH --gpus=v100-32:4
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err

set -x

cd /ocean/projects/cis250209p/apham8/asr-thesis-project || exit 1

module load anaconda3
source $(conda info --base)/etc/profile.d/conda.sh
conda activate env

export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH

# Qwen2-Audio-7B in fp16 + LoRA on the language model. ~17 GB of weights per
# rank; batch 1 x 16 accumulation x 4 ranks = 64 sequences per optimizer step.
accelerate launch \
    --num_processes=4 \
    --multi_gpu \
    -m asr_thesis_project.train_multimodal \
    model=qwen2_audio \
    training=multimodal \
    lora=qwen2_audio \
    use_lora=true \
    dataset=speech2latex_multimodal \
    training.max_steps=5000
