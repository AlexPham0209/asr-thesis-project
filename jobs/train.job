#!/bin/bash
#SBATCH -N 1
#SBATCH -p GPU-shared
#SBATCH -t 24:00:00
#SBATCH --gpus=v100-32:4
#SBATCH --output=logs/slurm-%j.out
#SBATCH --error=logs/slurm-%j.err

# General-purpose training launcher for any model/training/lora/dataset config
# under src/configs/ — replaces writing a near-identical .job file per model.
#
# The #SBATCH resources above default to the common LoRA fine-tune footprint
# (4x V100-32GB, GPU-shared). Override at submit time for configs that need
# more, e.g. the 8-GPU ASR runs:
#   sbatch --gpus=v100-32:8 -p GPU jobs/train.job entrypoint=train_asr ...
#
# Usage:
#   sbatch jobs/train.job entrypoint=<train_asr|train_post_correction|train_multimodal> \
#       model=<config> training=<config> dataset=<config> [lora=<config>] \
#       [num_processes=N] [use_lora=true|false] [run_name=...] [study_name=...] \
#       [any.other.hydra.override=value ...]
#
# Examples:
#   sbatch jobs/train.job entrypoint=train_post_correction \
#       model=qwen2_5_1.5b training=sft lora=llama dataset=speech2latex_llm \
#       training.max_steps=5000
#
#   sbatch jobs/train.job entrypoint=train_post_correction \
#       model=qwen3_1.7b training=sft lora=llama dataset=speech2latex_llm \
#       training.max_steps=5000
#
#   sbatch --gpus=v100-32:8 -p GPU jobs/train.job num_processes=8 \
#       entrypoint=train_asr model=wav2vec2_base_960h training=ctc lora=whisper \
#       dataset=speech2latex use_hyperparameter_search=true n_trials=2 \
#       training.max_steps=5000

ENTRYPOINT=train_post_correction
MODEL=
TRAINING=
LORA=
DATASET=
NUM_PROCESSES=4
USE_LORA=true
RUN_NAME=null
STUDY_NAME=null
EXTRA_ARGS=()

for arg in "$@"; do
    case $arg in
        entrypoint=*) ENTRYPOINT="${arg#*=}" ;;
        model=*) MODEL="${arg#*=}" ;;
        training=*) TRAINING="${arg#*=}" ;;
        lora=*) LORA="${arg#*=}" ;;
        dataset=*) DATASET="${arg#*=}" ;;
        num_processes=*) NUM_PROCESSES="${arg#*=}" ;;
        use_lora=*) USE_LORA="${arg#*=}" ;;
        run_name=*) RUN_NAME="${arg#*=}" ;;
        study_name=*) STUDY_NAME="${arg#*=}" ;;
        *) EXTRA_ARGS+=("$arg") ;;
    esac
done

if [[ -z "$MODEL" || -z "$TRAINING" || -z "$DATASET" ]]; then
    echo "Usage: sbatch jobs/train.job entrypoint=<train_asr|train_post_correction|train_multimodal> model=<config> training=<config> dataset=<config> [lora=<config>] [num_processes=N] [...]" >&2
    exit 1
fi

# Echo executed commands for debugging
set -x

# Navigate to project root
cd /ocean/projects/cis250209p/apham8/asr-thesis-project || exit 1

# Load Anaconda and initialize shell hook for non-interactive bash
module load anaconda3
source $(conda info --base)/etc/profile.d/conda.sh
conda activate env

export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH

LORA_ARGS=()
if [[ -n "$LORA" ]]; then
    LORA_ARGS=(lora="$LORA")
fi

accelerate launch \
    --num_processes="$NUM_PROCESSES" \
    --multi_gpu \
    -m "asr_thesis_project.$ENTRYPOINT" \
    model="$MODEL" \
    training="$TRAINING" \
    dataset="$DATASET" \
    use_lora="$USE_LORA" \
    "${LORA_ARGS[@]}" \
    run_name=$RUN_NAME \
    study_name=$STUDY_NAME \
    "${EXTRA_ARGS[@]}"
