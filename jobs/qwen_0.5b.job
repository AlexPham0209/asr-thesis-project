#!/bin/bash
#SBATCH -N 1
#SBATCH -p GPU-shared
#SBATCH -t 24:00:00
#SBATCH --gpus=v100-32:4
#SBATCH --output=logs/slurm-%j.out
#SBATCH --error=logs/slurm-%j.err

# Usage: sbatch qwen_0.5b.job [run_name=...] [study_name=...]
RUN_NAME=null
STUDY_NAME=null

for arg in "$@"; do
    case $arg in
        run_name=*) RUN_NAME="${arg#*=}" ;;
        study_name=*) STUDY_NAME="${arg#*=}" ;;
        *) echo "Unknown argument: $arg" >&2; exit 1 ;;
    esac
done

# Echo executed commands for debugging
set -x

# Navigate to project root
cd /ocean/projects/cis250209p/apham8/asr-thesis-project || exit 1

# Load Anaconda and initialize shell hook for non-interactive bash
module load anaconda3
source $(conda info --base)/etc/profile.d/conda.sh
conda activate env

export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH

# Launch multi-GPU training
accelerate launch \
    --num_processes=4 \
    --multi_gpu \
    -m asr_thesis_project.train_post_correction \
    model=qwen_0.5b \
    training=sft \
    lora=llama \
    use_lora=true \
    dataset=speech2latex_llm \
    training.max_steps=5000 \
    run_name=$RUN_NAME \
    study_name=$STUDY_NAME