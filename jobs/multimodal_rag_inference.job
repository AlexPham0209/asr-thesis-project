#!/bin/bash
#SBATCH -N 1
#SBATCH -p GPU-shared
#SBATCH -t 12:00:00
#SBATCH --gpus=v100-32:1
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err

# Gemini receives the query audio + retrieved examples (audio + LaTeX).
# Needs GEMINI_API_KEY in the project .env (read by load_dotenv).
# Usage: sbatch multimodal_rag_inference.job [query_mode] [embedding] [collection_name] [top_n] [max_eval_samples] [results_directory]
#   cascade (default):     sbatch multimodal_rag_inference.job asr_text bge speech2latex-bge-text 3 null results/multimodal_rag
#   cascade, no retrieval: sbatch multimodal_rag_inference.job asr_text bge speech2latex-bge-text 0 null results/multimodal_rag_no_retrieval
#   audio retrieval:       sbatch multimodal_rag_inference.job audio whisper speech2latex-whisper-audio 3 null results/multimodal_rag_whisper
#   audio, no retrieval:   sbatch multimodal_rag_inference.job audio whisper speech2latex-whisper-audio 0 null results/multimodal_rag_whisper_no_retrieval

QUERY_MODE=${1:-asr_text}
EMBEDDING=${2:-bge}
COLLECTION_NAME=${3:-speech2latex-${EMBEDDING}-text}
TOP_N=${4:-3}
MAX_EVAL_SAMPLES=${5:-null}
RESULTS_DIRECTORY=${6:-results/multimodal_rag}

set -x

cd /ocean/projects/cis250209p/apham8/asr-thesis-project || exit 1

module load anaconda3
source $(conda info --base)/etc/profile.d/conda.sh
conda activate env

export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH

python \
    -m asr_thesis_project.multimodal_rag_inference \
    query_mode=$QUERY_MODE \
    embedding=$EMBEDDING \
    collection_name=$COLLECTION_NAME \
    top_n=$TOP_N \
    max_eval_samples=$MAX_EVAL_SAMPLES \
    num_proc=${SLURM_CPUS_ON_NODE:-4} \
    results_directory=$RESULTS_DIRECTORY
