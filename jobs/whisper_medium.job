#!/bin/bash
#SBATCH -N 1
#SBATCH -p GPU
#SBATCH -t 24:00:00
#SBATCH --gpus=v100-32:8
#SBATCH --output=logs/slurm-%j.out
#SBATCH --error=logs/slurm-%j.err

# Usage: sbatch whisper_medium.job [run_name=...] [study_name=...]
RUN_NAME=null
STUDY_NAME=null

for arg in "$@"; do
    case $arg in
        run_name=*) RUN_NAME="${arg#*=}" ;;
        study_name=*) STUDY_NAME="${arg#*=}" ;;
        *) echo "Unknown argument: $arg" >&2; exit 1 ;;
    esac
done

# Echo commands to stdout for tracking
set -x

# Navigate to project directory
cd /ocean/projects/cis250209p/apham8/asr-thesis-project || exit 1

# Safely load and activate environment
module load anaconda3
source $(conda info --base)/etc/profile.d/conda.sh
conda activate env

export LD_LIBRARY_PATH=$CONDA_PREFIX/lib:$LD_LIBRARY_PATH

# Launch multi-GPU training across all 8 V100s
accelerate launch \
    --num_processes=8 \
    --multi_gpu \
    -m asr_thesis_project.train_asr \
    model=whisper_medium \
    training=seq2seq \
    lora=whisper \
    use_lora=true \
    use_hyperparameter_search=true \
    n_trials=2 \
    dataset=speech2latex \
    training.max_steps=5000 \
    run_name=$RUN_NAME \
    study_name=$STUDY_NAME